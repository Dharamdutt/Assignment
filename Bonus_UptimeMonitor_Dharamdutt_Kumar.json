{
  "name": "Bonus_UptimeMonitor_Dharamdutt_Kumar",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "id": "node-schedule-5min",
      "name": "Schedule Trigger (Every 5 Mins)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Initialize ping telemetry\nreturn {\n  json: {\n    target_url: \"https://demo.realworld.io\",\n    endpoint: \"https://demo.realworld.io/api/tags\",\n    ping_timestamp: new Date().toISOString(),\n    start_time_epoch: Date.now()\n  }\n};"
      },
      "id": "node-init-telemetry",
      "name": "Initialize Ping Telemetry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://demo.realworld.io/api/tags",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "User-Agent",
              "value": "Oytra-Uptime-Monitor-Bot/1.0 (Dharamdutt Kumar)"
            }
          ]
        },
        "options": {
          "timeout": 8000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        }
      },
      "id": "node-http-ping",
      "name": "Ping Conduit Demo App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        580,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Analyze probe response & calculate round-trip latency\nconst initialData = $('Initialize Ping Telemetry').first().json;\nconst pingResult = $input.item;\nconst endTimeEpoch = Date.now();\nconst latencyMs = endTimeEpoch - initialData.start_time_epoch;\n\n// Determine HTTP status code and error flags\nlet statusCode = 200;\nlet isFailed = false;\nlet failureReason = null;\n\nif (pingResult.error) {\n  isFailed = true;\n  statusCode = pingResult.error.response ? pingResult.error.response.status : 503;\n  failureReason = pingResult.error.message || \"Connection timeout or unreachable host\";\n} else if (pingResult.json && pingResult.json.statusCode && pingResult.json.statusCode !== 200) {\n  isFailed = true;\n  statusCode = pingResult.json.statusCode;\n  failureReason = `Returned non-200 HTTP status code: ${statusCode}`;\n}\n\nconst isDegraded = latencyMs > 2500;\n\nreturn {\n  json: {\n    target_url: initialData.target_url,\n    checked_at: new Date().toISOString(),\n    status_code: statusCode,\n    response_time_ms: latencyMs,\n    is_healthy: !isFailed && statusCode === 200,\n    is_degraded: isDegraded,\n    failure_reason: failureReason,\n    retry_policy: \"3 attempts with 2000ms backoff\"\n  }\n};"
      },
      "id": "node-calc-metrics",
      "name": "Calculate Latency & Health Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-health-check",
              "leftValue": "={{ $json.is_healthy }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-healthy",
      "name": "IF: Target is Healthy (Status 200)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Log successful health ping\nconst metric = $input.first().json;\nreturn {\n  json: {\n    status: \"HEALTHY\",\n    target: metric.target_url,\n    logged_at: metric.checked_at,\n    status_code: metric.status_code,\n    latency: `${metric.response_time_ms}ms`\n  }\n};"
      },
      "id": "node-log-healthy",
      "name": "Log Heartbeat Metric",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build Incident Alert Payload\nconst d = $input.first().json;\n\nconst incidentPayload = {\n  incident_id: `INC-${Date.now()}`,\n  severity: d.status_code >= 500 ? \"CRITICAL\" : \"HIGH\",\n  target_url: d.target_url,\n  status_code: d.status_code,\n  response_time_ms: d.response_time_ms,\n  reason: d.failure_reason,\n  timestamp: d.checked_at,\n  alert_message: `🚨 **OUTAGE ALERT: RealWorld App Service Degraded/Offline**\\n` +\n                 `• **Endpoint:** ${d.target_url}\\n` +\n                 `• **Status Code:** \\`${d.status_code}\\`\\n` +\n                 `• **Response Time:** \\`${d.response_time_ms}ms\\`\\n` +\n                 `• **Root Failure:** ${d.failure_reason}\\n` +\n                 `• **Retry Execution:** 3 automatic retries failed before alerting.`\n};\n\nreturn {\n  json: incidentPayload\n};"
      },
      "id": "node-format-incident",
      "name": "Format Incident Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        440
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://webhook.site/placeholder-oytra-incident-endpoint",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ $json }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Incident-Severity",
              "value": "={{ $json.severity }}"
            }
          ]
        },
        "options": {
          "timeout": 5000
        }
      },
      "id": "node-dispatch-incident",
      "name": "Dispatch Incident Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        440
      ],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Schedule Trigger (Every 5 Mins)": {
      "main": [
        [
          {
            "node": "Initialize Ping Telemetry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize Ping Telemetry": {
      "main": [
        [
          {
            "node": "Ping Conduit Demo App",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ping Conduit Demo App": {
      "main": [
        [
          {
            "node": "Calculate Latency & Health Metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Latency & Health Metrics": {
      "main": [
        [
          {
            "node": "IF: Target is Healthy (Status 200)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: Target is Healthy (Status 200)": {
      "main": [
        [
          {
            "node": "Log Heartbeat Metric",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Incident Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Incident Alert": {
      "main": [
        [
          {
            "node": "Dispatch Incident Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "oytra-assessment-uptime-monitor"
  },
  "tags": [
    {
      "name": "QA Assessment"
    },
    {
      "name": "Uptime Monitoring"
    },
    {
      "name": "SRE"
    }
  ]
}